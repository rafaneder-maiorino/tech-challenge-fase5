# Copy to .env (never committed) and start the API with:
#   uv run --env-file .env uvicorn support_copilot.api.main:app --port 8000

# LLM used by /chat: fake (default, no key, extractive) | gemini | openai
LLM_PROVIDER=fake
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# LLM_MAX_TOKENS=400
# LLM_TIMEOUT_S=30

# Retrieval (defaults calibrated in reports/retrieval_eval.md)
# RAG_TOP_K=4
# RAG_MIN_SCORE=0.67
# RAG_CHUNK_SIZE=1500
# RAG_CHUNK_OVERLAP=225
